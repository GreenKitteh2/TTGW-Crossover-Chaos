summary = "The Toon is embarrassed by the mundane attire!"
attack_lines = Array[String](["Better dress for our meeting. (I forgot to...)", "You can't go OUT without your tie. (I don't even like ties...)", "The best dressed Cogs wear them. (I don't count...)", "Try this on for size. (It's too small for me...)", "You should dress for success. (I'm a failiure...)", "No tie, no service. (Just wear the tie for once...)", "Do you need help putting this on? (I don't...)", "Nothing says powerful like a good tie. (I don't like wearing it...)", "Let's see if this fits. (It's too big for me...)", "This is going to choke you up. (It's too small...)", "You'll want to dress up before you go OUT. (You don't want to make the same mistake...)", "I think I'll tie you up. (I can't wear it...)"])
