summary = "The Cog feels the power!"
attack_lines = Array[String](["You look a little tripped up...", "Oh, uh, sorry to trip you up there...!", "How was your trip...?", "Pack your bags, we're um... taking a little trip.", "Heh, who's got the power now?", "Now you see who's in power, I think!", "I am pretty sure I am much more powerful than you.", "Power corrupts... especially in my hands...", "You can't fight the power.", "Did you have a nice trip...?"])
