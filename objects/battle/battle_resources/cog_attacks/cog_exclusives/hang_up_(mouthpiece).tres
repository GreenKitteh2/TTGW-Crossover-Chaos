[resource]
script = ExtResource("1_eaibv")
summary = "The Toon can't get a word in with the Cog!"
attack_lines = Array[String](["Maybe you should change your tone before ringing me again.", "This old lady's not ready to hang up her hat just yet!", "If you decide to dial back, perhaps you could dial down as well.", "Oh dear, it appears I have the wrong number! Toodle-oo!"])
action_name = "Hang Up"
