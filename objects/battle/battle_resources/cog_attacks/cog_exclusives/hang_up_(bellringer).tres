summary = "The Toon can't get a word in with the Cog!"
attack_lines = Array[String](["Right, I'm severin' this link.", "Your time's up, love.", "You got the wrong number, mate.", "I do think you 'ave a few hang ups.", "It appears you've got a proper weak link.", "Thank you, come again.", "It's really rather time I end our connection.", "I hope you receive this right loud an' clear."])
