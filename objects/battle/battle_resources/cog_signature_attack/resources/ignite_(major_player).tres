script = ExtResource("1_oucie")
damage = 4
summary = "Burns the Toon!"
attack_lines = Array[String](["Clearly you don’t own an air fryer, babe.", "Tune so hot, hot hot tune, tune so hot you fry a Toon.", "Come on babe, here's a real hot tune!", "This tune's got some more flare than you can handle!", "Better not dance cold on my floor.", "It ain't a Summer Tune without some sun, baby!", "How're these for some fire notes, babe?", "Don't care for the blues? Let's heat it up!", "I play this one a little con fuoco!", "Burnin up babe?"])
